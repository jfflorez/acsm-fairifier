<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?eclipse-pydev version="1.0"?><pydev_project>
        
    <pydev_property name="org.python.pydev.PYTHON_PROJECT_INTERPRETER">Default</pydev_property>
        
    <pydev_property name="org.python.pydev.PYTHON_PROJECT_VERSION">python interpreter</pydev_property>
    
    <pydev_pathproperty name="org.python.pydev.PROJECT_SOURCE_PATH">
        <path>/${PROJECT_DIR_NAME}</path>
        <path>/${PROJECT_DIR_NAME}/src</path>
        <path>/${PROJECT_DIR_NAME}/src/iointerface</path>
        <path>/${PROJECT_DIR_NAME}/src/algo</path>
        <path>/${PROJECT_DIR_NAME}/src/converter</path>
        <path>/${PROJECT_DIR_NAME}/src/misc</path>
        <path>/${PROJECT_DIR_NAME}/src/product</path>
        <path>/${PROJECT_DIR_NAME}/src/db</path>
    </pydev_pathproperty>
</pydev_project>
