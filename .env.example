# .env.example  (copy to .env; keep .env in .gitignore)

# 1 = pick files from the shared data folder, 0 = upload with dash-uploader
APP_SHARED_MODE=1

# Data folder (shared folder and upload destination). Relative to project root.
APP_DATA_DIR=data

# 1 = Dash debug on, 0 = off (e.g. Renku)
DASH_DEBUG=1

# Set to 1 inside Docker to skip opening a browser. Leave empty locally.
DOCKER_CONTAINER=
